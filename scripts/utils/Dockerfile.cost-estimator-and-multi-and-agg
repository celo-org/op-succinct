# syntax=docker/dockerfile:1.4

# Build stage with full development environment
FROM ubuntu:24.04 AS builder

WORKDIR /workspace

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    clang \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    ca-certificates \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.24 (required for sp1-recursion-gnark-ffi)
RUN curl -LO https://go.dev/dl/go1.24.0.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.24.0.linux-amd64.tar.gz && \
    rm go1.24.0.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH=/root/.cargo/bin:$PATH

# Copy rust-toolchain from workspace root
COPY rust-toolchain.toml ./
RUN rustup show && \
    rm -rf ~/.rustup/toolchains/stable-*

# Install SP1
RUN curl -L https://sp1.succinct.xyz | bash && \
    ~/.sp1/bin/sp1up -v 6.2.4 && \
    ~/.sp1/bin/cargo-prove prove --version
ENV PATH=/root/.sp1/bin:$PATH

# Copy entire workspace
COPY . .

# Build both binaries
RUN cargo build --release --bin cost-estimator --features eigenda && \
    cargo build --release --bin multi-and-agg --features eigenda

# Runtime stage - minimal image
FROM ubuntu:24.04

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy resources directory
COPY --from=builder /workspace/resources/ ./resources/

# Copy only the built binaries
COPY --from=builder /workspace/target/release/cost-estimator /usr/local/bin/cost-estimator
COPY --from=builder /workspace/target/release/multi-and-agg /usr/local/bin/multi-and-agg

# Default command — image is meant to be `exec`d into for ad-hoc runs.
CMD ["bash", "-c", "tail -f /dev/null"]

