# syntax=docker/dockerfile:1.4

FROM rust:1.89.0-trixie AS base

WORKDIR /app

# Install required dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    clang \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install SP1
RUN curl -L https://sp1.succinct.xyz | bash && \
    ~/.sp1/bin/sp1up && \
    ~/.sp1/bin/cargo-prove prove --version


FROM base AS chef
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    cargo install cargo-chef --locked \
    && cargo install sccache --locked

ENV RUSTC_WRAPPER=/usr/local/cargo/bin/sccache \
    SCCACHE_DIR=/usr/local/cargo/sccache

FROM chef AS planner
COPY . .
RUN --mount=type=cache,id=rustup,target=/usr/local/rustup \
    --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json

RUN --mount=type=cache,id=rustup,target=/usr/local/rustup \
    --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=sccache,target=/usr/local/cargo/sccache \
    cargo chef cook --release --recipe-path recipe.json

COPY . .

RUN --mount=type=cache,id=rustup,target=/usr/local/rustup \
    --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=sccache,target=/usr/local/cargo/sccache \
    set -eux; \
    cargo build --release --bin proposer --features eigenda; \
    install -Dm755 target/release/proposer /out/proposer; \
    sccache --show-stats

# Runtime stage
FROM rust:1.89.0-trixie AS runtime

WORKDIR /app
COPY resources/ ./resources/

# Copy the built proposer binary
COPY --from=builder /out/proposer /usr/local/bin/proposer

# Set the command
CMD ["proposer"]
