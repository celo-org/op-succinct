# syntax=docker/dockerfile:1.4

FROM rust:1.89.0-trixie AS base

WORKDIR /app

# Install required dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    clang \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install SP1
RUN curl -L https://sp1.succinct.xyz | bash && \
    ~/.sp1/bin/sp1up && \
    ~/.sp1/bin/cargo-prove prove --version


FROM base AS builder

WORKDIR /app

# Build the binary
COPY . .

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    cargo install sccache --locked

ENV RUSTC_WRAPPER=/usr/local/cargo/bin/sccache
ENV SCCACHE_DIR=/usr/local/cargo/sccache

RUN --mount=type=cache,id=sccache,target=/usr/local/cargo/sccache \
    --mount=type=cache,id=rustup,target=/usr/local/rustup \
    --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=target-proposer,target=/app/target \
    set -eux; \
    cargo build --release --bin proposer --features eigenda; \
    install -Dm755 /app/target/release/proposer /out/proposer; \
    sccache --show-stats

# Runtime stage
FROM rust:1.89.0-trixie 

WORKDIR /app
COPY resources/ ./resources/

# Copy the built proposer binary
COPY --from=builder /out/proposer /usr/local/bin/proposer

# Set the command
CMD ["proposer"]
