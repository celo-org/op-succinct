# syntax=docker/dockerfile:1.4

FROM rust:1.94.0-trixie AS base

WORKDIR /app

# Install required dependencies
RUN apt-get update && apt-get install -y \
    curl \
    clang \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.24 (required for sp1-recursion-gnark-ffi)
RUN curl -LO https://go.dev/dl/go1.24.0.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.24.0.linux-amd64.tar.gz && \
    rm go1.24.0.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Install SP1
RUN curl -L https://sp1.succinct.xyz | bash && \
    ~/.sp1/bin/sp1up -v 6.2.4 && \
    ~/.sp1/bin/cargo-prove prove --version


FROM base AS builder

WORKDIR /app
COPY . .

# Build the binary
RUN cargo build --locked --release --bin proposer --features eigenda

# Keep the system CA bundle current for native-tls and legacy rustls clients.
FROM ubuntu:24.04 AS runtime-base

WORKDIR /app

# USN-8944-1 removes the compromised eMudhra chain. Fail rather than ship an older bundle.
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl-dev \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20260816ubuntu0.24.04.1 \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS runtime

# Create configs directories and copy pre-existing configs from fault-proof/configs/ for custom L1 (local devnet)
RUN mkdir -p ./configs/L1
COPY --from=builder /app/fault-proof/configs/L1/ ./configs/L1/

COPY resources/ ./resources/

# Copy the built proposer binary
COPY --from=builder /app/target/release/proposer /usr/local/bin/

# Set the command
CMD ["proposer"]
